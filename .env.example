# Upstash Redis / Vercel KV (suggestions board + push subscriptions)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Web Push (generate with: npm run vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
