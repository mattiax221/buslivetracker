# Upstash Redis / Vercel KV (suggestions board + push subscriptions)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Web Push (generate with: npm run vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/cron/smart-alerts (GitHub Actions / external cron: Bearer)
CRON_SECRET=

# Public site URL (optional; used by cron when fetching arrivals)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
